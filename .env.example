# Status Saver Pro — environment variables
#
# Copy this file to `.env` for local development, or set these in your
# Vercel project's Environment Variables settings for production.
#
# The app degrades gracefully when the required vars below are unset:
#   - Forms still validate and return a success response to the user
#   - Submissions are logged to the server console instead of persisted
#   - No emails are sent (their content is logged instead)
# This means `npm run build` and a first deploy work with zero env vars —
# add these to enable real persistence + email notifications.

# ---------------------------------------------------------------------------
# REQUIRED for persisting Contact / Bug Report submissions to a database
# ---------------------------------------------------------------------------
# Postgres connection string. Use Vercel Postgres or Neon (either works —
# both are serverless-friendly). See DEPLOY.md for exact setup steps.
DATABASE_URL=

# ---------------------------------------------------------------------------
# REQUIRED for sending email notifications on new submissions
# ---------------------------------------------------------------------------
# Resend API key (https://resend.com) — used to notify the support inbox
# whenever the Contact or Report a Problem form is submitted.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — where notification emails are sent
# ---------------------------------------------------------------------------
# Defaults to `siteConfig.supportEmail` in src/lib/site.ts if unset.
SUPPORT_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# OPTIONAL — distributed rate limiting for the API routes
# ---------------------------------------------------------------------------
# Without these, /api/contact and /api/report-bug fall back to a simple
# in-memory rate limiter (5 requests/min/IP per server process — resets on
# cold start). Set these for a proper serverless-friendly limiter backed by
# Upstash Redis (https://upstash.com, free tier available).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
